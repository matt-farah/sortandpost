<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Only used for a Developer ID (hardened runtime) build that gets notarized.
     The ad-hoc build doesn't enable the hardened runtime, so it doesn't need these. -->
<plist version="1.0">
<dict>
    <!-- torch / numpy JIT paths and PyInstaller's bootloader -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- bundled dylibs (torch, libraw, libheif) are signed by us, not their authors -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
