# Copy to .env and edit. Consumed by docker-compose.yml.

# Host path to the photo library to organize. Mounted read-write into the
# container at /library (EXIF writeback needs write access; only the metadata
# engine ever writes there). For multiple libraries, add more mounts in
# docker-compose.yml and list them under `library_roots` in sync/config.yaml.
PHOTO_LIBRARY=/absolute/path/to/photos

# Host path to the app-data folder. Contains local/ (never synced) and sync/
# (point OneDrive / Google Drive / Synology Drive / Dropbox at APP_DATA/sync).
APP_DATA=/absolute/path/to/sortandpost-data

# Port the web UI is served on.
PORT=8080

# Optional: override the CLIP model at startup (otherwise sync/config.yaml wins).
# CLIP_MODEL=ViT-B-32
