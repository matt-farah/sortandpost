# Copy to .env and edit. Consumed by docker-compose.yml.

# Host path to the photo library to organize. Mounted read-write into the
# container at /library (EXIF writeback needs write access; only the metadata
# engine ever writes there). For more libraries add extra volume lines to
# docker-compose.yml (the Settings page shows you the exact line). Library
# folders are PER-DEVICE now -- pick them in Settings, not in config.yaml.
PHOTO_LIBRARY=/absolute/path/to/photos

# Host path to the shared library folder (sync/) -- the folder your sync tool
# carries between computers, and the one the desktop apps pick in their setup.
#   Synology NAS:  the shared folder on the NAS itself, e.g.
#                  SYNC_DIR=/volume1/homes/you/Drive/sortandpost
#   Mac / PC:      a folder inside Google Drive / OneDrive, set to "available
#                  offline" (mirror mode) so Docker sees real files, e.g.
#                  SYNC_DIR=/Users/you/Library/CloudStorage/GoogleDrive-you@example.com/My Drive/sortandpost
SYNC_DIR=/absolute/path/to/shared/sortandpost

# Optional: this container's own data (working DB, device id, app trash). Leave
# unset for a Docker volume. NEVER inside a synced folder.
# LOCAL_DIR=/absolute/path/to/sortandpost-local

# Name shown to other computers ("read-only · <name>", "Take over editing").
DEVICE_NAME=sortandpost-docker

# The app runs as this user / group inside the container (never root). On a Linux
# host or a Synology, use the owner of PHOTO_LIBRARY and SYNC_DIR (`id <user>`).
# Docker Desktop on a Mac / PC maps ownership itself, so 1000 works there.
# PUID=1000
# PGID=1000

# Port the web UI is served on.
PORT=8080

# Address the port is published on. 127.0.0.1 = this computer only (default).
# There is no login yet: only use 0.0.0.0 on a network you trust.
# BIND=127.0.0.1

# Optional: override the CLIP model at startup (otherwise sync/config.yaml wins).
# CLIP_MODEL=ViT-B-32

# Optional: posting-service API keys (robopost.app, Postiz). On a native run, prefer pasting it into
# Settings -> Posting, which stores it in the OS keychain (never in APP_DATA).
# Under Docker (no keychain) set it here. A real env var always wins.
# ROBOPOST_API_KEY=
# POSTIZ_API_KEY=      (same rules; the Postiz server address is set in Settings -> Posting)
